{
  "name": "norbelys",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "sdks/typescript"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=./apps/*",
    "build": "turbo run build",
    "check": "SQLX_OFFLINE=true turbo run check:fast --concurrency=1",
    "fix": "bun run format",
    "db": "docker compose -f docker/services.yml up -d postgres",
    "db:mail": "docker compose -f docker/services.yml --profile mail up -d mailpit",
    "local:setup": "./scripts/dev-init.sh",
    "check:database": "bun scripts/test-database.mjs",
    "lint": "turbo run lint --filter=norbelys-rust --filter=norbelys && bun run lint:javascript",
    "sdk:generate": "turbo run generate",
    "docs:dev": "turbo run dev --filter=@norbelys/docs",
    "docs:validate": "turbo run validate --filter=@norbelys/docs",
    "selfhost:setup": "bun scripts/selfhost.ts",
    "selfhost:migrate": "bun scripts/selfhost.ts --migrate",
    "selfhost:start": "bun scripts/selfhost.ts --start",
    "lint:javascript": "ultracite check",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "type-coverage:tools": "type-coverage --project tsconfig.tools.json --at-least 100 --detail --strict --report-semantic-error",
    "format": "ultracite fix && cargo fmt --all && uv run --frozen --package norbelys ruff format sdks/python",
    "format:check": "turbo run fmt && bun run lint:javascript",
    "coverage:rust": "bun scripts/rust-coverage.mjs workspace",
    "coverage:cli": "bun scripts/rust-coverage.mjs cli",
    "audit:javascript": "bun .github/scripts/audit-dependencies.mjs",
    "audit:python": "uv export --frozen --quiet --all-packages --all-groups --no-emit-workspace --output-file /tmp/norbelys-audit-requirements.txt && uvx --from pip-audit==2.10.1 pip-audit --require-hashes --disable-pip --requirement /tmp/norbelys-audit-requirements.txt",
    "check:all": "turbo run validate --concurrency=1 && bun run test:all",
    "test:all": "bun scripts/test-all.mjs",
    "test:scripts": "bun test ./.github/scripts",
    "db:reset": "cargo xtask db reset && cargo xtask db migrate"
  },
  "devDependencies": {
    "@types/bun": "~1.3.14",
    "braces": "3.0.3",
    "http-cache-semantics": "4.2.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "turbo": "2.11.6",
    "type-coverage": "2.30.3",
    "typescript": "6.0.3",
    "ultracite": "7.12.0"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "axios": "1.20.0",
    "fflate": "0.8.3",
    "js-yaml@^3": "3.15.2",
    "js-yaml@^4": "4.3.2",
    "qs": "6.16.0",
    "sharp": "0.35.5",
    "undici@^7": "7.30.0"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "braces@3.0.3": "patches/braces@3.0.3.patch",
    "http-cache-semantics@4.2.0": "patches/http-cache-semantics@4.2.0.patch"
  }
}
