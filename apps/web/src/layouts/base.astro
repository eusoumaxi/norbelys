---
import "../../../../brand/motion/norbelys-motion.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/header.css";
import "../styles/hero.css";
import "../styles/sections.css";
import "../styles/footer.css";
import favicon from "../../../../brand/icons/favicon.svg?url";
import appleIcon from "../../../../brand/icons/apple-touch-icon.png?url";
import social from "../../../../brand/social/og.png?url";
import outfitText from "@fontsource/outfit/files/outfit-latin-400-normal.woff2?url";
import outfitHeading from "@fontsource/outfit/files/outfit-latin-600-normal.woff2?url";

/**
 * The public document shell, with local assets and consistent search metadata. A page can add
 * its own tags to the head (a feed, an article's dates) through the `head` slot.
 */
interface Props {
  title: string;
  description?: string;
  type?: "website" | "article";
}
const {
  title,
  type = "website",
  description = "Cold email that gets replies. Send personal emails from your own inboxes, follow up on autopilot, stop when someone answers and work every reply from one inbox. From $20/mo, AI included.",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialUrl = new URL(social, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Motion is an enhancement: ask for it before first paint, and give it up if the page
      // script never arrives, so nothing waits forever to be revealed.
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("motion");
        window.setTimeout(() => {
          if (!Object.hasOwn(document.documentElement.dataset, "ready")) {
            document.documentElement.classList.remove("motion");
          }
        }, 4000);
      }
    </script>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={appleIcon} />
    <link rel="preload" href={outfitHeading} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={outfitText} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Norbelys" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Norbelys — cold email that gets replies" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body><slot /></body>
</html>
