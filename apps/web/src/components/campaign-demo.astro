---
import Illustration from "./illustration.astro";
import Icon from "./icon.astro";
---

<div class="campaign-demo" data-demo data-scene="message">
  <div class="demo-guide">
    <div class="demo-tabs" data-demo-tabs hidden aria-label="Campaign walkthrough">
      <button type="button" id="tab-message" data-demo-tab="message" aria-label="Make it personal"><span class="step-heading">Make it personal<Icon name="right" /></span><span class="step-description">Alex’s regional expansion gives the introduction a reason to exist. A follow-up is planned three days later.</span></button>
      <button type="button" id="tab-pace" data-demo-tab="pace" aria-label="Set the pace"><span class="step-heading">Set the pace<Icon name="right" /></span><span class="step-description">The same follow-up fits inside your London sending window, subject to this connection’s daily budget.</span></button>
      <button type="button" id="tab-reply" data-demo-tab="reply" aria-label="Catch the reply"><span class="step-heading">Catch the reply<Icon name="right" /></span><span class="step-description">A human reply interrupts that path. The planned follow-up stops before it is sent.</span></button>
    </div>
    <div class="demo-drawing"><Illustration name="campaign" decorative /></div>
    <p class="demo-aside">The same campaign.<br />Every decision connected.</p>
  </div>
  <div class="demo-workspace">
    <div class="demo-toolbar"><span>Partnerships <span class="overview-divider">/</span> EMEA</span><span class="example-label">Illustrative walkthrough</span></div>
    <div class="demo-flow" aria-hidden="true"><span class="flow-progress"></span><span>Introduction</span><span>Sending rules</span><span>Conversation</span></div>
    <div class="operation-map" aria-label="The sending boundary and reply rule for Alex’s next follow-up">
      <div class="origin-step"><span class="flow-point"></span><span>Introduction to Alex Morgan <strong>12 May · 09:15</strong></span></div>
      <div class="path-boundary">
        <span class="map-label">Next sending window</span>
        <h3>09:00 – 17:00</h3><span class="map-zone">Europe/London</span>
        <div class="window-axis"><span>09:00</span><span>13:00</span><span>17:00</span></div>
        <div class="window-track"><span class="scheduled-point"></span></div>
        <div class="window-admission"><Icon name="check" /><span>09:15 is inside your window</span></div>
        <div class="week-window" aria-label="Monday through Friday enabled; Saturday and Sunday excluded"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span class="day-off">Sat</span><span class="day-off">Sun</span></div>
        <p class="boundary-budget">25 messages per day <span>Per connection</span></p>
        <span class="path-cut" aria-hidden="true"><Icon name="add" /></span>
      </div>
      <div class="next-step">
        <span class="next-step-label">Next follow-up</span><strong class="next-step-date">15 May<br /><span>09:15</span></strong>
        <span class="next-step-status next-step-planned">Planned<br /><span>Three days after the introduction</span></span>
        <span class="next-step-status next-step-constrained">Within your window<br /><span>Subject to the daily budget</span></span>
        <span class="next-step-status next-step-stopped">Stopped<br /><span>Human reply detected</span></span>
      </div>
      <div class="reply-signal"><div class="signal-drawing"><div class="signal-art signal-art-waiting"><Illustration name="mailbox" decorative /></div><div class="signal-art signal-art-reply"><Illustration name="inbox" decorative /></div></div><div><span class="map-label">Human-reply stop rule · Enabled</span><p class="signal-waiting">Room for the conversation.<br /><strong>A reply will stop the next step.</strong></p><p class="signal-received">Alex replies · 12 May, 10:42<br /><strong>The next step stops here.</strong></p></div></div>
    </div>
    <section class="demo-panel" id="panel-message" data-demo-panel="message" aria-label="Make it personal">
      <div class="message-meta"><span>Subject</span><strong>An idea for your regional expansion</strong></div>
      <div class="email-body"><p>“I noticed you're expanding your partner network in Europe. We work with regional partners who could be a good fit for your next chapter.”</p></div>
      <div class="message-footer"><span><span class="status-dot"></span>Introduction · Variant A</span><span>Personal context included</span></div>
    </section>
    <section class="demo-panel" id="panel-pace" data-demo-panel="pace" aria-label="Set the pace">
      <div class="pace-panel-intro"><p class="panel-title">Your rules travel with the message.</p><p>The planned 09:15 follow-up fits the London window. Sending still respects the connection’s budget and pace.</p></div>
      <p class="static-settings">Monday–Friday · 09:00–17:00 Europe/London · 25 messages per day, per connection.</p>
      <div class="message-footer"><span><span class="status-dot"></span>15 minutes between cold emails</span><span>Unsubscribes respected</span></div>
    </section>
    <section class="demo-panel" id="panel-reply" data-demo-panel="reply" aria-label="Catch the reply">
      <div class="message-meta"><span>From</span><strong>Alex Morgan · 12 May, 10:42</strong></div>
      <div class="email-body"><p>“Thanks for reaching out. We're reviewing regional partnerships now, so your timing is good. Let's compare notes next week.”</p></div>
      <div class="message-footer"><span><Icon name="check" />Human reply detected</span><span>Follow-ups stopped</span></div>
    </section>
  </div>
</div>
