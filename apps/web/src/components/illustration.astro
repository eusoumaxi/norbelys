---
import { ILLUSTRATIONS } from '../../../../brand/illustrations';
import type { IllustrationName } from '../../../../brand/illustrations';

/** Draws a shared illustration without copying or redefining its paths. */
interface Props { name: IllustrationName; decorative?: boolean; animate?: boolean }
const { name, decorative = false, animate = false } = Astro.props;
const drawing = ILLUSTRATIONS.find((item) => item.name === name);
const svgNames: Record<string, string> = { className: "class", strokeDasharray: "stroke-dasharray", strokeWidth: "stroke-width" };
const shapes = drawing?.shapes.map(([tag, attrs]) => ({
  tag,
  attrs: Object.fromEntries(Object.entries(attrs).map(([key, value]) => [svgNames[key] ?? key, value])),
}));
---
<svg class="illustration" data-draw={animate || undefined} viewBox="0 0 240 160" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" role={decorative ? undefined : "img"} aria-label={decorative ? undefined : drawing?.label} aria-hidden={decorative ? "true" : undefined}>
  {shapes?.map(({ tag: Tag, attrs }) => <Tag {...attrs} />)}
</svg>
