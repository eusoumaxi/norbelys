---
import Illustration from "./illustration.astro";
import Icon from "./icon.astro";

/** An explicitly illustrative campaign overview ties its steps to sending controls and a reply. */
---

<figure class="campaign-overview" aria-label="Illustrated example of a campaign and its connected controls">
  <figcaption><span>A campaign, connected.</span><span class="example-label">Illustrative example</span></figcaption>
  <div class="overview-shell">
    <div class="overview-top"><span>Norbelys <span class="overview-divider">/</span> Campaigns</span><span class="status-dot"></span></div>
    <div class="overview-title"><div><h2>Partnerships · EMEA</h2><span>Campaign overview</span></div><Illustration name="campaign" decorative /></div>
    <div class="overview-grid">
      <div class="overview-steps">
        <div class="overview-step"><span class="flow-point"></span><div><span class="overview-label">Introduction</span><strong>12 May · 09:15</strong><p>A relevant first hello.</p></div></div>
        <div class="overview-step"><span class="flow-point"></span><div><span class="overview-label">Planned follow-up</span><strong class="overview-stopped-date">15 May · 09:15</strong><p>Stopped before sending.</p></div></div>
        <div class="overview-step overview-step-reply"><span class="flow-point"></span><div><span class="overview-label">Human reply · 12 May, 10:42</span><strong>Follow-ups stopped.</strong><p>The configured rule changes the next action.</p></div></div>
      </div>
      <aside class="overview-controls" aria-label="Example sending controls">
        <span class="overview-label">Sending boundaries</span>
        <dl><div><dt>Send window</dt><dd>09:00 – 17:00</dd><span>Europe/London</span></div><div><dt>Daily budget</dt><dd>25 messages</dd><span>Per connection</span></div><div><dt>Stop rule</dt><dd>Human reply</dd><span>Enabled for this example</span></div></dl>
      </aside>
    </div>
    <div class="overview-bottom"><Icon name="check" /><span>A reply changes what happens next.</span></div>
  </div>
  <div class="overview-annotation"><Illustration name="welcome" decorative /><p>One continuous thread.<br /><span>From your mailbox. Back to you.</span></p></div>
</figure>
