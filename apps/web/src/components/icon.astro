---
import { Add01Icon, ArrowDown01Icon, ArrowRight01Icon, ArrowUpRight01Icon, Menu01Icon, Tick02Icon } from "@hugeicons/core-free-icons";

/** Uses the product's icon family as static SVG, without a client runtime. */
interface Props { name: "add" | "down" | "right" | "external" | "menu" | "check" }
const icons = { add: Add01Icon, down: ArrowDown01Icon, right: ArrowRight01Icon, external: ArrowUpRight01Icon, menu: Menu01Icon, check: Tick02Icon };
const names: Record<string, string> = { strokeLinecap: "stroke-linecap", strokeLinejoin: "stroke-linejoin", strokeWidth: "stroke-width" };
const shapes = icons[Astro.props.name].map(([tag, attributes]) => ({ tag, attributes: Object.fromEntries(Object.entries(attributes).filter(([key]) => key !== "key").map(([key, value]) => [names[key] ?? key, value])) }));
---
<svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">{shapes.map(({tag: Tag, attributes}) => <Tag {...attributes} />)}</svg>
