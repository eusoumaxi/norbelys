---
/**
 * One frame on the founders' gallery wall: a thick ink moulding with round corners around a white
 * mat, hung from a nail on a wire. What it frames is the slot. The moulding is drawn at the size
 * the layout gives the frame, so its line is the same weight on every frame on the page.
 *
 * With motion, a hung frame waits a few degrees off level (`tilt`), draws itself in (in the order
 * its section's stylesheet gives it) and straightens under the pointer (scripts/gallery.ts).
 * Without motion it hangs straight, already drawn.
 */
interface Props {
  /** Degrees off level, until someone straightens it. */
  tilt?: number;
  /** Hangs from a nail on a wire; off for a frame that leans or lies flat. */
  hung?: boolean;
  class?: string;
}
const { tilt = 0, hung = true, class: className } = Astro.props;
---

<div class:list={["frame", className]} data-frame data-tilt={tilt} style={`--tilt: ${tilt}deg`}>
  <svg class="frame-line" aria-hidden="true">
    {
      hung && (
        <g class="frame-hanger">
          <line class="frame-wire" x1="50%" y1="-34" x2="24%" y2="2" pathLength="1" />
          <line class="frame-wire" x1="50%" y1="-34" x2="76%" y2="2" pathLength="1" />
          <circle class="frame-nail" cx="50%" cy="-34" r="6.5" />
        </g>
      )
    }
    <rect class="frame-edge" width="100%" height="100%" rx="22" pathLength="1"></rect>
  </svg>
  <div class="frame-mat"><slot /></div>
</div>
