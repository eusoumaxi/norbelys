---
import Closing from "../../components/closing.astro";
import Glyph from "../../components/glyph.astro";
import Marked from "../../components/marked.astro";
import PostCard from "../../components/post-card.astro";
import PostCover from "../../components/post-cover.astro";
import PostMeta from "../../components/post-meta.astro";
import Page from "../../layouts/page.astro";
import { getPosts, postUrl } from "../../posts";
import "../../styles/blog.css";

/** The blog's front page: the post to read first, large, then everything else, newest first. */
const posts = await getPosts();
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const rest = posts.filter((post) => post !== featured);
---

<Page
  title="Blog — Norbelys"
  description="Playbooks, templates and straight answers about cold email, for people who sell."
  class="blog"
>
  <link slot="head" rel="alternate" type="application/rss+xml" title="Norbelys blog" href="/blog/rss.xml" />
  <section class="blog-hero container" aria-labelledby="blog-title">
    <h1 id="blog-title" data-inview>
      <span class="line">Cold email,</span>
      <span class="line">done <Marked>right</Marked><span class="pink">.</span></span>
    </h1>
    <div class="blog-intro">
      <p class="lead">
        Playbooks, templates and straight answers for people who sell. Written by the team building
        Norbelys.
      </p>
      <a class="text-link" href="/blog/rss.xml">Follow with RSS <Glyph name="arrow" /></a>
    </div>
  </section>

  {
    featured && (
      <section class="container blog-featured" aria-label="Featured post">
        <article class="post-feature glyph-host">
          <PostCover cover={featured.data.cover} size="feature" />
          <div class="post-feature-text">
            <PostMeta post={featured} />
            <h2 class="post-feature-title">
              <a href={postUrl(featured)}>{featured.data.title}</a>
            </h2>
            <p class="post-feature-summary">{featured.data.description}</p>
            <span class="post-feature-more" aria-hidden="true">
              Read the post <Glyph name="arrow" />
            </span>
          </div>
        </article>
      </section>
    )
  }

  {
    rest.length > 0 && (
      <section class="container blog-latest" aria-labelledby="latest-title">
        <h2 id="latest-title" class="blog-section-title">
          Latest posts
        </h2>
        <ul class="post-grid">
          {rest.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <Closing />
</Page>
