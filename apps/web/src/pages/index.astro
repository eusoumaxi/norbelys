---
import Base from "../layouts/base.astro";
import SiteHeader from "../components/site-header.astro";
import SiteFooter from "../components/site-footer.astro";
import Hero from "../components/hero.astro";
import TheNeed from "../components/the-need.astro";
import Tour from "../components/tour.astro";
import Deliverability from "../components/deliverability.astro";
import ProductsGrid from "../components/products-grid.astro";
import Pricing from "../components/pricing.astro";
import Audience from "../components/audience.astro";
import Faq from "../components/faq.astro";
import Closing from "../components/closing.astro";
---

<Base title="Norbelys — Cold email that gets replies, from $20/mo">
  <a class="skip-link" href="#main">Skip to content</a>
  <SiteHeader />
  <main id="main">
    <Hero />
    <TheNeed />
    <Tour />
    <Deliverability />
    <ProductsGrid />
    <Pricing />
    <Audience />
    <Faq />
    <Closing />
  </main>
  <SiteFooter />
  <script src="../homepage.ts"></script>
</Base>
