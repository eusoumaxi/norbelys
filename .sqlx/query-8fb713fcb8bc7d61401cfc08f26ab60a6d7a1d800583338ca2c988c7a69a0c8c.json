  "query": "SELECT s.campaign_id AS \"campaign: Id<Campaign>\", v.step_id AS \"step: Id<Step>\", v.version\n                 FROM variants v JOIN steps s ON s.workspace_id = v.workspace_id AND s.id = v.step_id\n                WHERE v.workspace_id = $1 AND v.id = $2 AND ($3::uuid IS NULL OR v.step_id = $3)",
