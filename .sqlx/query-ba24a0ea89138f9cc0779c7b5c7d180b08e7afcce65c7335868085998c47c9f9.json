  "query": "SELECT id AS \"id: Id<OutboxEvent>\", type AS kind, payload, created_at AS \"created_at: Timestamp\"\n                 FROM outbox_events\n                WHERE workspace_id = $1 AND ($2::text IS NULL OR type = $2) AND ($3::uuid IS NULL OR id > $3)\n                  AND ($4::uuid IS NULL OR id > $4)\n                ORDER BY id LIMIT $5",
