  "query": "SELECT person_id, group_id AS \"group_id: Id<Group>\" FROM group_people m\n            WHERE workspace_id = $1 AND person_id = ANY($2) AND EXISTS (SELECT 1 FROM groups g WHERE g.workspace_id = m.workspace_id AND g.id = m.group_id AND g.deleted_at IS NULL) ORDER BY person_id, group_id",
