  "query": "SELECT id AS \"id: Id<Segment>\", name, filter, created_at AS \"created_at: Timestamp\", updated_at AS \"updated_at: Timestamp\"\n             FROM segments\n            WHERE workspace_id = $1 AND ($2::uuid IS NULL OR CASE WHEN $3 THEN id > $2 ELSE id < $2 END)\n            ORDER BY CASE WHEN $3 THEN id END, id DESC LIMIT $4",
