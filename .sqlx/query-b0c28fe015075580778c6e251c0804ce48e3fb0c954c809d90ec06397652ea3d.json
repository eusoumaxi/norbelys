  "db_name": "PostgreSQL",
  "query": "SELECT c.status, c.credential_version, c.paused, c.account_email,\n                      w.id AS \"webhook?: Id<ProviderWebhook>\", w.signing_secret\n                 FROM connections c\n                 LEFT JOIN provider_webhooks w ON w.workspace_id = c.workspace_id AND w.connection_id = c.id\n                WHERE c.workspace_id = $1 AND c.id = $2 AND c.provider = 'norbelys'",
