  "query": "SELECT m.kind, m.subject, m.text_body, m.from_email, q.paced, q.deadline_at AS \"deadline_at: Timestamp\"\n             FROM messages m JOIN delivery_queue q ON q.workspace_id = m.workspace_id AND q.message_id = m.id\n            WHERE m.workspace_id = $1 AND m.id = $2",
