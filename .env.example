# Every environment variable of every Norbelys program, grouped by the program and role that
# read it, each with its default and what it means. No secret values: placeholders only.
#
# Local development: `./scripts/dev-init.sh` writes `.env.local` from this file, with a fresh
# deployment key and a database of this worktree's own. The programs read the process
# environment, then a `.env` file in the working directory or a parent for what is still unset
# (the server binary, local `cargo xtask db` commands, sqlx's compile-time query checks); none of them reads
# `.env.local`, so load it into the shell first:
#
#   set -a; . ./.env.local; set +a        (or direnv, with `dotenv .env.local` in .envrc)
#
# `NAME=value` lines are what local development sets. `# NAME=default` lines document a
# variable and its default without setting it: several roles read the same name with different
# defaults, and in production every role gets its own env file, rendered by the infrastructure
# repository into /run/norbelys/env/<role>.env. A new variable without a line here fails the
# configuration tests of its crate.
#
# A role refuses to start on a variable of its own families (NORBELYS_, API_, SENDER_, INBOX_,
# TRACKING_, INGRESS_, DELIVERY_, JOB_, WEBHOOK_, AI_, MAIL_, MTA_, OAUTH_, GOOGLE_OAUTH_,
# MICROSOFT_OAUTH_, DASHBOARD_, WEBAUTHN_, CAPTCHA_, RECAPTCHA_, IDENTITY_, OBJECT_STORE_,
# SYSTEM_DATABASE_) that no role reads and this file does not list: a typo would otherwise be
# ignored. Outside development it also refuses a variable that only other roles read, so each
# role's env file holds its own settings and no secret lands in a role that has no use for it.

# --- Every role of `norbelys-server <role>` ---------------------------------------------------
# The role's own database login. In production each role connects as its PostgreSQL role:
# api as norbelys_app; sender, inbox and worker as norbelys_worker; tracking as
# norbelys_tracking; admin and analytics as norbelys_system. External manual maintenance uses
# MIGRATION_DATABASE_URL and is never executed by the server. Locally a development
# superuser serves `cargo xtask db migrate/reset` and sqlx checks; to run a
# role as itself, give it its own login on the command line (the development password of
# every login is `norbelys`):
#   DATABASE_URL=postgres://norbelys_app:norbelys@127.0.0.1:5433/norbelys_dev turbo run dev:api
DATABASE_URL=postgres://norbelys:norbelys@127.0.0.1:5433/norbelys_dev
# Base64 of the 32-byte deployment key: it seals stored credentials and keys every HMAC. Every
# role keeps only the subkeys of it that its work uses. `norbelys-server admin deployment-key`
# prints a fresh one; to change it, see NORBELYS_PREVIOUS_DEPLOYMENT_KEY.
NORBELYS_DEPLOYMENT_KEY=
# In production, instead of NORBELYS_DEPLOYMENT_KEY: the role's own key (nbrk_…), only the
# subkeys that role uses (the tracking role holds no sealing key, no background role an
# identity secret), printed by `admin deployment-key --for <api|ingress|sender|inbox|worker|tracking>`
# from the deployment key (and the previous one during a rotation). Made again after a rotation.
# NORBELYS_ROLE_KEY=
# During a rotation of the deployment key, the previous one: values it sealed or signed still
# open and verify, nothing new is made with it. Rotate by setting the new key here beside the
# old one, running `admin secrets rotate` until it reports no row left, then removing this once
# links in mail sent before the rotation need not work any longer. The rotation ends browser
# sessions, OAuth refresh tokens and pending sign-in codes and invitations (their stored hashes
# are keyed); API keys survive it.
# NORBELYS_PREVIOUS_DEPLOYMENT_KEY=
# Where the role answers /health/live, /health/ready and /metrics (Prometheus's text format). The api
# and tracking answer their probes on HTTP_ADDR and only /metrics here, best effort: a taken
# address (several roles on one machine) leaves /metrics out and the role running.
# HEALTH_ADDR=127.0.0.1:8090
# The OTLP/HTTP endpoint (a collector, or the backend's gateway); unset keeps telemetry local,
# as JSON lines on standard output.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# Start with complete traces; reduce to 90 or 60 after observing launch traffic.
NORBELYS_TRACE_SAMPLE_PERCENT=100
# Direct SigNoz Cloud export uses the SDK standard OTLP header configuration.
# Keep ingestion credentials in private runtime settings, never VITE_* variables.
# OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<private-ingestion-key>
# The self-hosted dashboard relay uses the same destination and a server-only credential.
# SIGNOZ_INGESTION_KEY=<private-ingestion-key>
# The deployment's name in telemetry (deployment.environment.name). Outside `development`,
# missing production settings (object storage) stop a role at start.
# NORBELYS_ENVIRONMENT=development
# The log filter (tracing's EnvFilter syntax).
RUST_LOG=info
# Database connections of the process: api 8 (4 in --mode ingress), worker 6, sender and
# inbox 4, tracking and analytics 2.
# DATABASE_POOL_SIZE=8

# --- api --------------------------------------------------------------------------------------
# The directory of the ingress spool, where provider callbacks wait on disk while the database
# cannot take them; on a disk that survives restarts. Unset, a `development` deployment keeps it
# under the system's temporary directory; any other refuses to start the ingress mode.
# INGRESS_SPOOL_DIR=
# `product` serves /v1, the dashboard surface and the protocols; `ingress` serves provider
# webhooks, one-click unsubscribes and public images only, on the public host.
# API_MODE=product
# The HTTP listener (the tracking role's default is 127.0.0.1:8081).
# HTTP_ADDR=127.0.0.1:3001
# The public origin of the API, for absolute links and Location headers.
# PUBLIC_API_URL=http://127.0.0.1:3001
# The dashboard's origins, comma-separated: the only Origins whose sign-in and cookie-authorised
# requests are accepted; the first is where links in mail point.
# DASHBOARD_ORIGINS=http://localhost:5173
# The WebAuthn relying party id of passkeys: the dashboard's registrable domain. Passkeys are
# bound to it for good, so it never changes once set.
# WEBAUTHN_RP_ID=localhost
# The captcha of the email-code challenge: turnstile, hcaptcha or recaptcha; unset, no captcha.
# CAPTCHA_PROVIDER=
# The captcha's public site key, given to the dashboard's widget.
# CAPTCHA_SITE_KEY=
# The captcha's secret (for reCAPTCHA, an API key allowed to create assessments).
# CAPTCHA_SECRET=
# The Google Cloud project of a reCAPTCHA captcha.
# RECAPTCHA_PROJECT=
# Take forwarded addresses only from an actual TCP peer in TRUSTED_PROXY_IPS; walk the chain
# or a client could choose its own rate-limit key.
# TRUST_FORWARDED_FOR=false
# TRUSTED_PROXY_IPS=127.0.0.1,10.0.0.1
# The api replicas the deployment runs: each holds this fraction of the per-workspace and
# per-person request budgets (the RateLimit policies default, send and access).
# API_REPLICAS=1
# Fetch identity providers' documents from private and loopback addresses over plain http
# (also read by the worker's daily SSO check). Development with a local provider only.
# IDENTITY_ALLOW_PRIVATE_ISSUERS=false
# Turn the OAuth authorization server off: /oauth/* and its metadata answer 404, and MCP clients
# and the command-line client use API keys as bearer tokens. For a deployment whose authorization
# server has not passed its gate.
# OAUTH_SERVER_DISABLED=false

# --- api and worker: sending ------------------------------------------------------------------
# Norbelys's Google OAuth client; without the id and the secret, Google connections are refused.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Norbelys's Microsoft app; without the id and the secret, Microsoft connections are refused.
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# The Microsoft tenant segment: `common` admits work, school and personal accounts; a tenant id
# admits one organisation.
# MICROSOFT_OAUTH_TENANT=common
# The one redirect URI registered with both providers: GET /v1/auth/callback as the browser
# reaches it through the dashboard's proxy, an https URL.
# OAUTH_REDIRECT_URL=
# The public origin providers post their callbacks to (<origin>/webhooks/{id}, the ingress host).
# PUBLIC_WEBHOOKS_URL=http://127.0.0.1:3001
# The host a sending domain's tracking hostname points its CNAME at.
# TRACKING_CNAME_TARGET=tracking.norbelys.localhost
# The managed MTA's submission host, written into `norbelys` connections.
# MTA_SUBMISSION_HOST=smtp.norbelys.localhost
# Optional SPF include: publish this TXT policy with your sending IPs first.
# MTA_SPF_INCLUDE=_spf.example.com
# The managed MTA's control API on the private network; without it and its secret, `norbelys`
# connections wait in `verifying`.
# MTA_CONTROL_PRIVATE_TRANSPORT=false
MTA_CONTROL_URL=
# The control API's per-installation Standard Webhooks secret (whsec_...).
# MTA_CONTROL_SECRET=
# Let mailbox and relay hosts resolve to private and loopback addresses, and allow plaintext
# sessions to them. Development with local fakes (Mailpit) only.
MAIL_ALLOW_PRIVATE_HOSTS=false

# --- api, sender, inbox and worker: object storage (any S3-compatible provider) -----------------------------
# s3://bucket[/prefix] or file:///absolute/directory. Unset, a `development` deployment keeps
# its objects under the system's temporary directory; any other refuses to start.
# OBJECT_STORE_URL=
# The credential and addressing of an s3:// store.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# The bucket's region; Cloudflare R2 takes `auto` and accepts `us-east-1` as its alias.
# AWS_REGION=us-east-1
# The S3 endpoint of a provider other than AWS (https://<account>.r2.cloudflarestorage.com).
# AWS_ENDPOINT_URL=
# Address the bucket as a host name instead of a path.
# AWS_VIRTUAL_HOSTED_STYLE_REQUEST=false
# Allow plain http to the endpoint: a local S3 server in development only.
# AWS_ALLOW_HTTP=false

# --- worker -----------------------------------------------------------------------------------
# The maintenance lane's own login, norbelys_system, for the system job kinds.
SYSTEM_DATABASE_URL=postgres://norbelys_system:norbelys@127.0.0.1:5433/norbelys_dev
# The PostgreSQL metrics scraper's login, norbelys_metrics (pg_monitor, no table grants), on one
# dedicated connection; unset, the pg_* metrics are not read.
# METRICS_DATABASE_URL=postgres://norbelys_metrics:norbelys@127.0.0.1:5433/norbelys_dev
# Jobs run at once per queue where they differ from the queue's default: comma-separated
# queue=permits pairs, such as webhooks=32,maintenance=2.
# JOB_PERMITS=
# The worker replicas the deployment runs: each holds this fraction of maintenance's share of the
# provider limits (connection checks). At least 1.
# WORKER_REPLICAS=1
# Deliver customer webhooks to private, loopback and reserved addresses and over plain http.
# Development with a local receiver only.
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# --- worker: AI ------------------------------------------------------------------------------
# One deployment key per provider; without a provider's key, the AI use cases configured on its
# models are unavailable and their jobs keep the decision they make without AI.
# ANTHROPIC_API_KEY=
# The Anthropic API's base URL, without /v1.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# The key of OpenAI's API, or of a server speaking OpenAI's chat completions (any value for a
# self-hosted server that wants none).
# OPENAI_API_KEY=
# The chat completions base URL, with its version: OpenAI's, or a self-hosted server's such as
# http://127.0.0.1:11434/v1 (plain http only to loopback or private addresses).
# OPENAI_BASE_URL=https://api.openai.com/v1
# The model catalogue, comma-separated provider/model=input:output, prices in USD per million
# tokens. Unset, the six models priced on 2026-10-01 (Claude Haiku 4.5, Sonnet 5.5, Opus 5.5;
# gpt-6-luna, gpt-6.1-sol, gpt-6-astra). Whether a model enforces a JSON schema is not set here:
# the AI client's tested capability matrix says so.
# AI_MODELS=anthropic/claude-haiku-4-5=1:5,anthropic/claude-sonnet-5-5=2:10,anthropic/claude-opus-5-5=4:20,openai/gpt-6-luna=0.10:0.50,openai/gpt-6.1-sol=2:10,openai/gpt-6-astra=10:50
# The day the catalogue's prices were read; older than 90 days, the worker warns at start.
# AI_PRICES_READ_ON=2026-10-01
# The model of each use case (provider/model, priced in the catalogue and marked strict by the
# capability matrix, or the worker refuses to start).
# AI_CLASSIFICATION_MODEL=anthropic/claude-haiku-4-5
# AI_SNIPPETS_MODEL=anthropic/claude-sonnet-5-5
# AI_HINTS_MODEL=anthropic/claude-haiku-4-5
# The deadline of one AI call, its retries included, in seconds (1 to 90).
# AI_TIMEOUT_SECONDS=60
# How far, in points of review rate (0 to 100), a canary prompt's review rate may exceed the
# current prompt's before the canary (5 % of classification calls for a day) is rolled back.
# AI_CANARY_MARGIN_POINTS=5

# --- sender, inbox and analytics ---------------------------------------------------------------
# The public origin of the tracking host, https: open pixels, click and unsubscribe links of
# campaign mail without a tracking domain of its own. Read by the sender (rendering), the api
# (where uploaded images are linked) and `admin render-message`.
# PUBLIC_TRACKING_URL=https://tracking.norbelys.localhost

# --- sender ---------------------------------------------------------------------------------
# The sender also reads the sending variables above (OAuth apps to refresh mailbox grants,
# MAIL_ALLOW_PRIVATE_HOSTS, MTA_SUBMISSION_HOST).
# Messages one sender process prepares and submits at once: its submission slots.
# SENDER_PERMITS=32
# The sender replicas the deployment runs: each holds this fraction of every provider rate limit.
# SENDER_REPLICAS=1
# How the provider limits that several roles spend (Gmail API units, Microsoft Graph requests)
# are split between sending, receiving and maintenance, each 0 to 1. The sender, the inbox and the
# worker each read all three and refuse to start when they sum above 1.
# SENDER_LIMIT_SHARE=0.8
# INBOX_LIMIT_SHARE=0.15
# MAINTENANCE_LIMIT_SHARE=0.05
# How long after its first submission a message keeps being tried, in hours.
# DELIVERY_RETRY_WINDOW_HOURS=24

# --- inbox ----------------------------------------------------------------------------------
# The inbox also reads the sending variables above (OAuth apps to refresh mailbox grants,
# MAIL_ALLOW_PRIVATE_HOSTS) and the object storage variables (inbound bodies).
# Mailboxes one inbox process polls at once. A claim never takes a binding while none is free.
# INBOX_PERMITS=32
# How often a binding is polled when nothing asks for sooner, in seconds: the reply latency the
# inbox is measured against.
# INBOX_POLL_INTERVAL_SECONDS=300
# The inbox replicas the deployment runs: each holds this fraction of receiving's share of the
# provider limits. At least 1.
# INBOX_REPLICAS=1

# --- tracking ---------------------------------------------------------------------------------
# The directory of the tracking role's spool, where opens and clicks wait on disk until its drain
# has stored them; on a disk that survives restarts. Unset, a `development` deployment keeps it
# under the system's temporary directory; any other refuses to start. The role also reads
# HTTP_ADDR (default 127.0.0.1:8081) and TRUST_FORWARDED_FOR.
# TRACKING_SPOOL_DIR=

# --- Tests and builds -------------------------------------------------------------------------
# The administrator URL the server's tests create and drop their databases with; its login must
# be allowed to create databases. Unset, the tests use DATABASE_URL.
# The evaluation of the AI prompts against the configured models (an ignored test, run on
# request with a provider key) records a passing run as the new baseline when set to 1.
# AI_EVAL_WRITE_BASELINE=0
# `true` makes sqlx's compile-time checks read the committed .sqlx/ instead of a database (the
# images and CI build that way); `cargo sqlx prepare --workspace -- --all-targets` refreshes it.
# SQLX_OFFLINE=false

# --- norbelys, the command-line client ------------------------------------------------------
# An API key (nb_live_..., nb_test_...) to use instead of the profile's credential, for CI.
# NORBELYS_API_KEY=
# The profiles live in $XDG_CONFIG_HOME/norbelys/config.json (else ~/.config/norbelys/).
# XDG_CONFIG_HOME=

# --- norbelys-smtp, the managed MTA's control plane (the mail host) --------------------------
# It also reads OTEL_EXPORTER_OTLP_ENDPOINT, NORBELYS_TRACE_SAMPLE_PERCENT,
# NORBELYS_ENVIRONMENT and RUST_LOG, as above.
# Local bounded pending evidence, locks and the provisioning trigger file.
# NORBELYS_SMTP_STATE_DIR=/var/lib/norbelys-smtp
# This host's name ([a-z0-9-], at most 63): the log cursor's key, part of every event id and
# remote table namespace. Required by `serve` and `provision-apply`.
# NORBELYS_SMTP_NODE=
# Canonical database: libsql://<database>.turso.io or an HTTP(S) self-hosted libSQL URL.
# Required by both serve and provision-apply; no local database replica is downloaded.
# NORBELYS_SMTP_DATABASE_URL=
# Bearer token. Empty only for a private self-hosted server without authentication.
# NORBELYS_SMTP_DATABASE_TOKEN=
# Maximum local queue and journal bytes (4 MiB to 64 GiB); records leave after Turso confirms.
# NORBELYS_SMTP_QUEUE_MAX_BYTES=1073741824
# The per-installation Standard Webhooks secret shared with the core (whsec_ + base64 of 24 to
# 64 bytes): it verifies every control request and seals route secrets at rest. Required.
# NORBELYS_SMTP_SECRET=
# The control API listener: a private interface, never a public one (plain HTTP).
# NORBELYS_SMTP_LISTEN=127.0.0.1:8443
# Admission control's Postfix policy-delegation listener, reachable from the mail container.
# NORBELYS_SMTP_POLICY_LISTEN=127.0.0.1:10040
# The LMTP listener Postfix delivers notifications for VERP return paths to.
# NORBELYS_SMTP_LMTP_LISTEN=127.0.0.1:10025
# The MTA's public host name: MX target, the SMTP and IMAP host handed to the core, the domain
# of VERP return paths. Required by `serve`; `provision-apply` needs it for return paths.
# NORBELYS_SMTP_MAIL_HOST=
# The MTA's sending IPv4 address, rendered into SPF. Required by `serve`.
# NORBELYS_SMTP_PUBLIC_IPV4=
# Optional shared SPF include; publish its authorized IPs in deployment DNS.
# Unset keeps direct IPv4 instructions for standalone mail installations.
# NORBELYS_SMTP_SPF_INCLUDE=_spf.example.com
# The DKIM selector of new domains; it must match Rspamd's dkim_signing path. Required.
# NORBELYS_SMTP_DKIM_SELECTOR=
# Comma-separated host names a route may post evidence to (the core's ingress); empty refuses
# every route.
# NORBELYS_SMTP_EVIDENCE_HOSTS=
# Comma-separated domains of the enrolled feedback loops (Yahoo's, Microsoft's): an abuse report
# DKIM-signed by one of them, or a subdomain, authenticates its complaint; empty authenticates
# none (a complaint is then only corroborated, by our own signed Feedback-ID).
# NORBELYS_SMTP_FBL_REPORTERS=
# Postfix's mail.log; unset turns the tail off.
# NORBELYS_SMTP_MAIL_LOG=
# A path on the volume holding Postfix's queue, measured by admission control; unset, the
# state directory.
# NORBELYS_SMTP_SPOOL_DIR=
# Admission closes below these free bytes and inodes or above this backlog, and reopens only
# past the second value of each pair.
# NORBELYS_SMTP_ADMISSION_CLOSE_FREE_BYTES=2147483648
# NORBELYS_SMTP_ADMISSION_OPEN_FREE_BYTES=3221225472
# NORBELYS_SMTP_ADMISSION_CLOSE_FREE_INODES=100000
# NORBELYS_SMTP_ADMISSION_OPEN_FREE_INODES=150000
# NORBELYS_SMTP_ADMISSION_CLOSE_BACKLOG=500000
# NORBELYS_SMTP_ADMISSION_OPEN_BACKLOG=400000
# docker-mailserver's configuration directory on the host (`provision-apply`). Required there.
# NORBELYS_SMTP_DMS_CONFIG_DIR=
# The upstream helper `dms-patch` patches inside the mail container.
# NORBELYS_SMTP_ACCOUNTS_SH=/usr/local/bin/helpers/accounts.sh

# Authorize plain control HTTP only on a private address protected by an encrypted tunnel.
# NORBELYS_SMTP_CONTROL_PRIVATE_TRANSPORT=false
# Local development tooling does not send anonymous usage telemetry. Load this file through
# local:setup; Turbo passes these settings to its child tools. CI sets the same opt-outs.
TURBO_TELEMETRY_DISABLED=1
ASTRO_TELEMETRY_DISABLED=1
WRANGLER_SEND_METRICS=false
# Re-read verified authority on every request by default. A positive value (at most 60)
# explicitly accepts that many seconds of revocation lag across API replicas.
# AUTHORITY_CACHE_SECONDS=0

# --- External manual maintenance and isolated tests -------------------------------------------
# Explicit operator environment only; cargo xtask provision/migrate do not load .env files.
# Never supply this identity to runtime application containers.
# MIGRATION_DATABASE_URL=
# Optional runtime passwords assigned by the explicit provision command; omitted means preserve.
# APP_DATABASE_PASSWORD=
# WORKER_DATABASE_PASSWORD=
# TRACKING_DATABASE_PASSWORD=
# SYSTEM_DATABASE_PASSWORD=
# METRICS_DATABASE_PASSWORD=
# A separate, dedicated local cluster is required for tests that create roles and databases.
# TEST_DATABASE_URL=
# NORBELYS_TEST_DATABASE_DISPOSABLE=1
